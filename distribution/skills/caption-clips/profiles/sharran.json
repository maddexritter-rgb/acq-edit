{
  "id": "sharran",
  "display_name": "Sharran",
  "normalization": "sentence_case",
  "max_lines": 2,
  "min_words_per_card": 4,
  "max_words_per_card": 10,
  "max_words_per_quote_card": 8,
  "max_chars_per_line": 23,
  "font_size_px": 48,
  "max_text_width_pct": 80,
  "frame_width_px": 1080,
  "reveal_mode": "adaptive",
  "line_reveal_min_delay_seconds": 1.15,
  "word_reveal_min_seconds_per_word": 0.72,
  "word_reveal_min_interword_gap_seconds": 0.65,
  "body_font_postscript": "Inter-SemiBold",
  "italic_font_postscript": "Inter-SemiBold",
  "allow_quote_italics": true,
  "allow_weight_variation": false,
  "shadow_profile": "official-premiere-preset",
  "premiere_text_style_preset": "presets/leila_captions_official.prtextstyle",
  "vendored_font": "fonts/inter/Inter-SemiBold.otf",
  "default_y_pct": 69.0,
  "caption_hold_through_seconds": 0.75,
  "caption_trailing_hold_seconds": 0.35,
  "filmcraft_caption_motion": "none"
}
